{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true
  },
  // All 27 files are now real ES modules (see git log for the increment-by-
  // increment conversion). noImplicitAny is still off because most function
  // params/fields are typed `any` rather than given real types -- flipping
  // it to true surfaces ~459 implicit-any errors across the codebase. That's
  // the scope of the next phase: tightening `any` to real types file by file,
  // same incremental approach as the JS->TS conversion itself.
  "include": ["**/*.ts", "**/*.js"],
  "exclude": ["node_modules", "dist"]
}
