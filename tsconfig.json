{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true
  },
  // All files are real ES modules with noImplicitAny enabled and zero
  // implicit-any errors (see git log for the file-by-file conversion and
  // type-tightening passes). Remaining `any` usage is deliberate: THREE.js
  // callback params (CDN r128 runtime doesn't match @types/three), and a
  // handful of documented pre-existing dead-code/bug sites.
  "include": ["**/*.ts", "**/*.js"],
  "exclude": ["node_modules", "dist"]
}
